# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/civicconnect

# Clerk Authentication (Get these from your Clerk Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Administrator Accounts (Comma-separated emails with administrative access)
ADMIN_EMAILS=admin@civicconnect.gov,ops@civicconnect.gov,commissioner@civicconnect.gov

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:3000
